<Window x:Class="Aion2DpsMeter.App.Views.MeterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AION 2 DPS Meter"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        MinWidth="220" MinHeight="90"
        Width="320" Height="260"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="6" BorderThickness="1" BorderBrush="#40FFFFFF" Background="#BF111318">
        <DockPanel LastChildFill="True">
            <!-- Header: drag to move -->
            <Border DockPanel.Dock="Top" Background="#661C2028" CornerRadius="6,6,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Height="26" Margin="6,0,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                        <Ellipse Width="7" Height="7" Margin="0,0,6,0" Fill="{StaticResource Good}"
                                 Visibility="{Binding InProgress, Converter={StaticResource BoolToVis}}" ToolTip="Fight in progress" />
                        <Ellipse Width="7" Height="7" Margin="0,0,6,0" Fill="{StaticResource Danger}"
                                 Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}" ToolTip="Recording packets" />
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Timer}" Foreground="{StaticResource SubText}"
                               VerticalAlignment="Center" Margin="6,0" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" x:Name="Buttons">
                        <Button Style="{StaticResource TextButton}" Content="Update" Click="Update_Click" Foreground="{StaticResource Good}"
                                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding UpdateLabel}" />
                        <Button Style="{StaticResource TextButton}" Content="{Binding ModeLabel}" Click="Mode_Click"
                                ToolTip="Switch damage / healing" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Click="Reset_Click" ToolTip="Reset meter" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE81C;" Click="History_Click" ToolTip="Fight history" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE713;" Click="Settings_Click" ToolTip="Settings" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE72E;" Click="Lock_Click"
                                ToolTip="Click-through: the mouse goes through the panel to the game" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE921;" Click="Hide_Click" ToolTip="Hide (tray icon brings it back)" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Boss HP -->
            <Grid DockPanel.Dock="Top" Height="14" Margin="6,4,6,0"
                  Visibility="{Binding ShowBossHp, Converter={StaticResource BoolToVis}}">
                <Border Background="#33FFFFFF" CornerRadius="2" />
                <Border Background="#C0B83A3A" CornerRadius="2" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding BossHpFraction}" />
                    </Border.RenderTransform>
                </Border>
                <TextBlock Text="{Binding BossHpText}" FontSize="10" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <!-- Footer -->
            <Grid DockPanel.Dock="Bottom" Margin="6,2,16,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Status}" FontSize="10" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Status}" MouseLeftButtonUp="Status_MouseLeftButtonUp">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource SubText}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsProblem}" Value="True">
                                    <Setter Property="Foreground" Value="#E0A060" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding TotalLine}" FontSize="10" Foreground="{StaticResource SubText}" Margin="8,0,0,0" />
            </Grid>

            <!-- Player rows -->
            <ItemsControl ItemsSource="{Binding Rows}" Margin="4,4,4,0">
                <ItemsControl.Effect>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.8" Color="Black" />
                </ItemsControl.Effect>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="21" Margin="0,0,0,2" Background="Transparent" Cursor="Hand"
                              MouseLeftButtonDown="Row_MouseLeftButtonDown"
                              ToolTip="Double-click for skill details">
                            <Border Background="#22FFFFFF" CornerRadius="2" />
                            <Border Background="{Binding BarBrush}" Opacity="0.6" CornerRadius="2"
                                    HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding BarFraction}" />
                                </Border.RenderTransform>
                            </Border>
                            <Grid Margin="5,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Rank}" Foreground="#C8CCD2" VerticalAlignment="Center" FontSize="11" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="White" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLocal}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="2" Text="{Binding Value}" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="White" />
                                <TextBlock Grid.Column="3" Text="{Binding PerSecond}" VerticalAlignment="Center" Margin="8,0,0,0"
                                           Foreground="#D8DCE2" x:Name="PerSecondText" />
                                <TextBlock Grid.Column="4" Text="{Binding Share}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Foreground="#C8CCD2" FontSize="11" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</Window>
