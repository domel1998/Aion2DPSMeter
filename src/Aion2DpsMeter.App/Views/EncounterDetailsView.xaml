<UserControl x:Class="Aion2DpsMeter.App.Views.EncounterDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="80" />
            <RowDefinition Height="6" />
            <RowDefinition Height="*" MinHeight="80" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Text="No fight selected" />
                <TextBlock x:Name="SubtitleText" Foreground="{StaticResource SubText}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource Button}" Content="Copy summary" Click="CopySummary_Click" Margin="0,0,6,0"
                        ToolTip="Copy a text summary (e.g. for Discord)" x:Name="CopyButton" />
                <Button Style="{StaticResource Button}" Content="Export JSON…" Click="Export_Click" x:Name="ExportButton" />
            </StackPanel>
        </Grid>

        <DataGrid Grid.Row="1" x:Name="PlayersGrid" SelectionChanged="PlayersGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="32" />
                <DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Class" Binding="{Binding Class}" Width="90" />
                <DataGridTextColumn Header="Damage" Binding="{Binding DamageText}" SortMemberPath="Damage" Width="90" ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="DPS" Binding="{Binding DpsText}" SortMemberPath="Dps" Width="80" ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="Share" Binding="{Binding ShareText}" SortMemberPath="Share" Width="60" ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="Heal" Binding="{Binding HealText}" SortMemberPath="Heal" Width="80" ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="HPS" Binding="{Binding HpsText}" SortMemberPath="Hps" Width="70" ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="Crit" Binding="{Binding CritText}" SortMemberPath="CritRate" Width="60" ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="Max hit" Binding="{Binding MaxHitText}" SortMemberPath="MaxHit" Width="80" ElementStyle="{StaticResource RightCell}" />
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="Transparent" />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="2*" MinWidth="200" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="SkillsTitle" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" Text="Skills" />
                <DataGrid x:Name="SkillsGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Skill" Binding="{Binding Name}" Width="*" MinWidth="150" />
                        <DataGridTextColumn Header="Damage" Binding="{Binding DamageText}" SortMemberPath="Damage" Width="70" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="Share" Binding="{Binding ShareText}" SortMemberPath="Share" Width="54" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="Hits" Binding="{Binding Hits}" Width="42" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="Crit" Binding="{Binding CritText}" SortMemberPath="CritRate" Width="58" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="Avg" Binding="{Binding AvgText}" SortMemberPath="Average" Width="60" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="Max" Binding="{Binding MaxText}" SortMemberPath="Max" Width="60" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="Back" Binding="{Binding BackText}" Width="58" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="Perf." Binding="{Binding Perfect}" Width="40" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="Dbl." Binding="{Binding Double}" Width="40" ElementStyle="{StaticResource RightCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" Text="Healing" />
                <DataGrid x:Name="HealsGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Skill" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Amount" Binding="{Binding AmountText}" SortMemberPath="Amount" Width="80" ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="Ticks" Binding="{Binding Ticks}" Width="50" ElementStyle="{StaticResource RightCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
